{
  "manifest_version": 3,
  "name": "Twitter Defang",
  "version": "1.0.0",
  "description": "Opens individual X/Twitter posts and their replies. Blocks every feed, and strips discovery and engagement modules.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://x.com/*",
    "*://twitter.com/*",
    "*://mobile.x.com/*",
    "*://mobile.twitter.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://twitter.com/*",
        "*://mobile.x.com/*",
        "*://mobile.twitter.com/*"
      ],
      "js": [
        "src/rules.js",
        "src/content.js"
      ],
      "css": [
        "src/hide.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/blocked.html"
      ],
      "matches": [
        "*://x.com/*",
        "*://twitter.com/*",
        "*://mobile.x.com/*",
        "*://mobile.twitter.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "src/options.html",
    "default_title": "Twitter Defang",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
